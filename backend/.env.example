# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
MONGO_URI=mongodb://localhost:27017/netflix_clone

# Firebase Admin SDK Credentials
# Obtain these from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_firebase_private_key_here\n-----END PRIVATE KEY-----\n"

# Allowed CORS Origins (comma-separated for multiple origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,http://localhost:5000,http://localhost:8080

# Administrator Credentials (comma-separated UIDs or email addresses)
ADMIN_EMAILS=admin@netflix.com,admin@example.com
ADMIN_UIDS=admin_firebase_uid_1,admin_firebase_uid_2

# TMDB API Configuration (if used server-side)
TMDB_API_KEY=your_tmdb_api_key_here
