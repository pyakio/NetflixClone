# ==========================================================================
# Netflix Clone — Root Environment Variables Template (.env.example)
# ==========================================================================

# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Connection String (Local or MongoDB Atlas)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/netflix_clone?retryWrites=true&w=majority

# Firebase Admin SDK Credentials
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_firebase_private_key_here\n-----END PRIVATE KEY-----\n"

# Allowed CORS Origins (comma-separated production origins)
ALLOWED_ORIGINS=https://your-netflix-clone.vercel.app,https://your-domain.com

# Administrator Email Whitelist (comma-separated)
ADMIN_EMAILS=admin@netflix.com,admin@example.com
ADMIN_UIDS=admin_firebase_uid_1

# TMDB API Key
TMDB_API_KEY=your_tmdb_api_key_here
